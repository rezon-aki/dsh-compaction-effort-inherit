{
  "name": "dsh-compaction-effort-inherit",
  "version": "0.1.0",
  "description": "DSH plugin: compaction keeps the session's reasoning effort, so DeepSeek's prefix cache still hits instead of re-billing the whole context.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "compaction",
    "prefix-cache",
    "reasoning-effort",
    "cordis"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7-rc.2"
    },
    "compatibility": {
      "dsh": ">=0.1.7-rc.2 <0.2.0",
      "dshReleases": {
        "0.1.7-rc.2": "compatible"
      },
      "profiles": [
        "web"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
